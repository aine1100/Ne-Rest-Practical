# ========================
# FEMS Environment Config
# ========================

# Node
NODE_ENV=development

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=fems
DATABASE_URL=postgresql://postgres:password@localhost:5432/fems

# Redis
REDIS_HOST=localhost
REDIS_PORT=7001
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP
OTP_EXPIRY_MINUTES=30
OTP_MAX_RESENDS=3

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FEMS System <noreply@fems.com>"

# Service Ports
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
EXTINGUISHER_SERVICE_PORT=3002
INSPECTION_SERVICE_PORT=3003
REPORTING_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3010

# Docker service hostnames (defaults to localhost for local dev)
# AUTH_SERVICE_HOST=auth
# EXTINGUISHER_SERVICE_HOST=extinguisher
# INSPECTION_SERVICE_HOST=inspection
# REPORTING_SERVICE_HOST=reporting
# NOTIFICATION_SERVICE_HOST=notification
